generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String
  name            String
  createdAt       DateTime         @default(now())
  emails          Email[]
  slackConnection SlackConnection?
}

model Campaign {
  id                 String   @id @default(uuid())
  userId             String
  subject            String
  body               String
  startTime          DateTime
  delayBetweenEmails Int      @default(2000)
  hourlyLimit        Int      @default(100)
  createdAt          DateTime @default(now())
  emails             Email[]
}

model Email {
  id           String    @id @default(uuid())
  campaignId   String?
  userId       String
  recipient    String
  subject      String
  body         String
  senderId     String?
  tenantId     String?
  scheduledAt  DateTime
  sentAt       DateTime?
  delayedUntil DateTime?
  status              String    @default("SCHEDULED")
  statusReason        String?
  messageId           String?
  previewUrl          String?
  errorMessage        String?
  attempts            Int       @default(0)
  processingStartedAt DateTime?
  processingWorkerId  String?
  leaseExpiresAt      DateTime?
  isStarred    Boolean   @default(false)
  isArchived   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  campaign Campaign? @relation(fields: [campaignId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  attachments Attachment[]

  @@index([status, scheduledAt])
  @@index([userId])
  @@index([campaignId])
  @@index([senderId])
}

model SlackConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  tenantId    String?
  workspaceId String
  accessToken String
  channelId   String?
  teamName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Attachment {
  id        String   @id @default(uuid())
  emailId   String
  filename  String
  path      String
  size      Int
  mimeType  String
  createdAt DateTime @default(now())

  email     Email    @relation(fields: [emailId], references: [id])

  @@index([emailId])
}
